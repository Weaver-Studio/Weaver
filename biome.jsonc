{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "linter": {
    "rules": {
      "correctness": {
        "noChildrenProp": "off"
      }
      // "style": {
      //   "noNonNullAssertion": "off"
      // }
    }
  },

  "json": {
    "parser": {
      "allowComments": true
    }
  }
}
