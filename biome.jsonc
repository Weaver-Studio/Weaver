{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": [
      "!node_modules",
      "!packages/ui/src/components/ui/*.tsx",
      "!**/worker-configuration.d.ts",
      "!dist",
      "!build"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        "noNamespaceImport": "off"
      },
      // "complexity": {
      //   "noForEach": "off"
      // },
      "nursery": {
        "useConsistentTypeDefinitions": "off"
      },
      "suspicious": {
        "noConsole": "warn"
      },
      "correctness": {
        "noChildrenProp": "off"
      },
      "style": {
        "useBlockStatements": "off"
      }
    }
  },

  "json": {
    "parser": {
      "allowComments": true
    }
  }
}
