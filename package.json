{
  "name": "weaver-mono-repo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "ui": "pnpm --filter @weaver/ui ui",
    "check": "npx ultracite@latest check",
    "fix": "npx ultracite@latest fix"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "husky": "^9.1.7",
    "ultracite": "5.6.4"
  }
}
