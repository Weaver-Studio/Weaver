{
  "name": "@weaver/api",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio --config=./drizzle.config.ts",
    "db:studio-local": "drizzle-kit studio --config=./drizzle.config.local.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.4",
    "@scalar/hono-api-reference": "^0.9.22",
    "@types/node": "^24.8.0",
    "better-auth": "1.3.27",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.2",
    "hono-pino": "^0.10.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "stoker": "^2.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.31",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "wrangler": "^4.45.0"
  }
}
